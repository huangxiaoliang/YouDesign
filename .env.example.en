# ---------- Run mode ----------
# false = use the real pipeline when keys are present; missing items fall back to mock automatically
YOUDESIGN_FORCE_MOCK=false

# ---------- Proxy (optional) ----------
# Set when public APIs go through a proxy; NO_PROXY lists domains/CIDRs that must be hit directly (suffix matching is resolved manually).
NO_PROXY=localhost,127.0.0.1,api.deepseek.com,open.bigmodel.cn,api.moonshot.cn,ark.cn-beijing.volces.com

# ---------- Data directory (persistent, outside the repo) ----------
# In production point this to a persistent dir outside the repo (e.g. /var/lib/youdesign) so git pull won't overwrite it. First-time deploy must seed users.json into this directory.
YOUDESIGN_DATA_DIR=

# ---------- Login / session ----------
# Generate with: openssl rand -hex 24. Passcode hashing is plain sha256 and does not depend on this value; users.json can be migrated directly.
YOUDESIGN_AUTH_SECRET=replace-with-openssl-rand-hex-24
# auto = multi-user mode when a user table is enabled, otherwise shared passcode; shared = force shared passcode; users = force user table.
YOUDESIGN_AUTH_MODE=auto
# Once multi-user mode is enabled, the shared-passcode fallback no longer applies; leave empty.
YOUDESIGN_ACCESS_PASSWORD=
YOUDESIGN_SESSION_TTL_SEC=604800

# ---------- LLM keys (fill in your own real keys) ----------
# Anthropic (Opus / Sonnet, native)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_OPUS=claude-opus-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5

# GLM 5.2 (Zhipu GLM, native, OpenAI-compatible)
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

# Zhipu embedding (semantic recall, optional)
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3

# GLM-5V (Zhipu vision model, optional when uploading images; by default reuses GLM_API_KEY/ZHIPU_API_KEY and GLM_BASE_URL)
GLM5V_API_KEY=
GLM5V_BASE_URL=
GLM5V_MODEL=glm-5v-turbo
GLM5V_MAX_OUTPUT_TOKENS=128000

# DeepSeek (official API, OpenAI-compatible format). flash = deepseek-v4-flash + thinking disabled; pro = deepseek-v4-pro + thinking enabled
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_OUTPUT_TOKENS=131072

# Model routing: use pro for structuring/generation to preserve quality; flash for clarify/small edits/large edits to speed up; multimodal (image upload) falls back to Sonnet automatically
ROUTE_CLARIFY=deepseek
ROUTE_STRUCTURE=deepseek
ROUTE_STRUCTURE_COMPLEX=deepseekPro
ROUTE_GENERATE=deepseekPro
ROUTE_EDIT_SMALL=deepseek
ROUTE_EDIT_LARGE=deepseek

# Kimi K3 (Volcengine Ark Agent Plan, Anthropic-compatible endpoint /v1/messages + Bearer, text+vision, optional vision model; requires enabling Agent Plan in the Ark console)
KIMI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
KIMI_API_KEY=your-kimi-api-key-here
KIMI_K3_MODEL=kimi-k3
KIMI_K3_MAX_OUTPUT_TOKENS=100000

# ---------- Usage storage (optional MySQL, falls back to local JSONL when absent) ----------
YOUDESIGN_MYSQL_HOST=
YOUDESIGN_MYSQL_PORT=3306
YOUDESIGN_MYSQL_DATABASE=youdesign
YOUDESIGN_MYSQL_USER=
YOUDESIGN_MYSQL_PASSWORD=
YOUDESIGN_MYSQL_CONNECTION_LIMIT=5
YOUDESIGN_MYSQL_CONNECT_TIMEOUT_MS=5000

# ---------- Desktop / Electron ----------
# Note: CLAUDE_* is only read by the Electron main process (from .env.local in the desktop config dir); the Next server does not read it.
YOUDESIGN_DESKTOP=false
YOUDESIGN_DESKTOP_AGENT=
YOUDESIGN_DESKTOP_ACCESS_PASSWORD=
YOUDESIGN_DESKTOP_TMP_DIR=
YOUDESIGN_DESKTOP_LOGS_DIR=
YOUDESIGN_DESKTOP_WEB_URL=
CLAUDE_CLI_PATH=claude
CLAUDE_AGENT_TIMEOUT_MS=300000
CLAUDE_AGENT_MAX_HTML_BYTES=15000000
CLAUDE_AGENT_MAX_TURNS=20
CLAUDE_AGENT_MAX_BUDGET_USD=3
CLAUDE_AGENT_JOBS_DIR=
CLAUDE_AGENT_BARE=false
