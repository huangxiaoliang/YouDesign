{
  "manifest_version": 3,
  "name": "YouDesign Capture",
  "version": "0.2.9",
  "description": "Capture the current logged-in Chrome page and send its rendered HTML to YouDesign.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "webNavigation"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Send current page to YouDesign",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["drawer_tracker.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "options.html"
}
