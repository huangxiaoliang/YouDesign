{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(node scripts/*)",
      "Bash(npm install *)",
      "Bash(npm view *)",
      "Bash(npm config *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git config *)",
      "Bash(gh pr *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(lsof -nP -iTCP:3000 -sTCP:LISTEN)",
      "Bash(pkill -f \"next start\")",
      "Bash(pkill -f \"next-server\")",
      "Bash(pkill -f \"next dev\")",
      "Bash(curl -s -o /dev/null -w * http://localhost:3000/*)",
      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -s -N -X POST http://localhost:3000/api/generate *)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/pre-bash-guard.py",
            "if": "Bash(git *)",
            "timeout": 10,
            "statusMessage": "git 守卫检查…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/post-edit-reminder.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel)}/.claude/hooks/stop-typecheck.py",
            "timeout": 120,
            "statusMessage": "typecheck…"
          }
        ]
      }
    ]
  }
}
