# ---------- 运行模式 ----------
# false = 有密钥走真实链路，缺失项自动回退 mock
YOUDESIGN_FORCE_MOCK=false

# ---------- 代理（可选）----------
# 公网 API 走代理时设；NO_PROXY 列出须直连的域名/网段（自行解析子域后缀匹配）。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,api.deepseek.com,open.bigmodel.cn,api.moonshot.cn,ark.cn-beijing.volces.com

# ---------- 数据目录（持久化，仓库外）----------
# 生产部署指向仓库外持久目录（如 /var/lib/youdesign），git pull 不会覆盖。
YOUDESIGN_DATA_DIR=

# ---------- 登录 / 会话 ----------
# 生成：openssl rand -hex 24。口令哈希是纯 sha256 不依赖此值，users.json 可直接迁移。
YOUDESIGN_AUTH_SECRET=replace-with-openssl-rand-hex-24
# auto=有启用用户表时多人模式，否则共享口令；shared=强制共享口令；users=强制用户表。
YOUDESIGN_AUTH_MODE=auto
# 多用户模式启用后共享口令回退不生效，留空。
YOUDESIGN_ACCESS_PASSWORD=
YOUDESIGN_SESSION_TTL_SEC=604800

# ---------- LLM 密钥（填你自己的真实 key）----------
# Anthropic（Opus / Sonnet 原生）
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_OPUS=claude-opus-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5

# GLM 5.2（智谱 GLM 原生，OpenAI 兼容）
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2

# 智谱 embedding（语义召回，可选）
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_EMBED_MODEL=embedding-3

# GLM-5V（智谱视觉模型，上传图片时可选；缺省复用 GLM_API_KEY/ZHIPU_API_KEY 与 GLM_BASE_URL）
GLM5V_API_KEY=
GLM5V_BASE_URL=
GLM5V_MODEL=glm-5v-turbo
GLM5V_MAX_OUTPUT_TOKENS=128000

# DeepSeek（官方 API，OpenAI 兼容格式）。flash=deepseek-v4-flash + thinking disabled；pro=deepseek-v4-pro + thinking enabled
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_MAX_OUTPUT_TOKENS=131072

# 模型路由：结构化/生成用 pro 保质量；澄清/小改/大改用 flash 提速
ROUTE_CLARIFY=deepseek
ROUTE_STRUCTURE=deepseek
ROUTE_STRUCTURE_COMPLEX=deepseekPro
ROUTE_GENERATE=deepseekPro
ROUTE_EDIT_SMALL=deepseek
ROUTE_EDIT_LARGE=deepseek

# Kimi K3（火山方舟 Agent Plan，Anthropic 兼容端点 /v1/messages + Bearer，text+vision，可选视觉模型；需在方舟控制台开通 Agent Plan）
KIMI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
KIMI_API_KEY=your-kimi-api-key-here
KIMI_K3_MODEL=kimi-k3
KIMI_K3_MAX_OUTPUT_TOKENS=100000

# ---------- 用量存储（可选 MySQL，缺失回退本地 JSONL）----------
YOUDESIGN_MYSQL_HOST=
YOUDESIGN_MYSQL_PORT=3306
YOUDESIGN_MYSQL_DATABASE=youdesign
YOUDESIGN_MYSQL_USER=
YOUDESIGN_MYSQL_PASSWORD=
YOUDESIGN_MYSQL_CONNECTION_LIMIT=5
YOUDESIGN_MYSQL_CONNECT_TIMEOUT_MS=5000

# ---------- Desktop / Electron ----------
# 注：CLAUDE_* 只由 Electron 主进程读取（桌面配置目录的 .env.local），Next 服务端不读。
YOUDESIGN_DESKTOP=false
YOUDESIGN_DESKTOP_TMP_DIR=
YOUDESIGN_DESKTOP_LOGS_DIR=
YOUDESIGN_DESKTOP_WEB_URL=
CLAUDE_CLI_PATH=claude
CLAUDE_AGENT_TIMEOUT_MS=300000
CLAUDE_AGENT_MAX_HTML_BYTES=15000000
CLAUDE_AGENT_MAX_TURNS=20
CLAUDE_AGENT_MAX_BUDGET_USD=3
CLAUDE_AGENT_JOBS_DIR=
CLAUDE_AGENT_BARE=false
